// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// In Prisma 7, the datasource URL is configured in prisma.config.ts, not here.
// See: https://pris.ly/d/config-datasource

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth models (Auth.js / NextAuth standard schema)
// https://authjs.dev/reference/adapter/prisma
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Core product models
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  userId           String
  name             String
  slug             String        @unique
  status           ProjectStatus @default(ACTIVE)
  prompt           String
  thumbnailUrl     String?
  currentVersionId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PageVersion[]
  seo      SeoMeta?
  exports  Export[]

  @@index([userId])
  @@index([userId, status])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// PageVersion.schema is the single JSON source of truth for a page's content,
// structure, and theme. Used identically by the editor, preview, and exporter.
model PageVersion {
  id         String   @id @default(cuid())
  projectId  String
  schema     Json
  isAutosave Boolean  @default(true)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model SeoMeta {
  id           String  @id @default(cuid())
  projectId    String  @unique
  title        String
  description  String
  ogImageUrl   String?
  canonicalUrl String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Export {
  id        String       @id @default(cuid())
  projectId String
  format    ExportFormat
  fileUrl   String
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum ExportFormat {
  REACT_NEXTJS
  STATIC_HTML
}

// GenerationLog supports success-rate and latency metrics from the PRD
// without needing a separate analytics pipeline in v1.
model GenerationLog {
  id           String           @id @default(cuid())
  userId       String
  projectId    String?
  prompt       String
  status       GenerationStatus
  errorMessage String?
  latencyMs    Int?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
}

enum GenerationStatus {
  SUCCESS
  FAILED
  RETRIED
}
